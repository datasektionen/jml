{
  "name": "jml-server",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/datasektionen/jml"
  },
  "engines": {
    "node": "=12.20.0"
  },
  "scripts": {
    "postinstall": "cd client && npm install",
    "build": "tsc && cd client && npm run build && cd .. && mkdir dist/client && mkdir dist/client/build && cp -r client/build/* dist/client/build/ && cp -r emails/ dist/emails",
    "prestart": "npx prisma migrate deploy",
    "dev": "nodemon",
    "start": "node dist/app.js",
    "test": "NODE_ENV=testing mocha --timeout 10000 -r ts-node/register test/*.ts --exit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "dependencies": {
    "@prisma/client": "^2.29.1",
    "@types/cors": "^2.8.12",
    "axios": "^0.21.1",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-openid-connect": "^2.19.2",
    "express-rate-limit": "^6.4.0",
    "express-session": "^1.18.2",
    "express-validator": "^6.10.1",
    "http-status-codes": "^2.1.4",
    "morgan": "^1.10.0",
    "path": "^0.12.7",
    "prisma": "^2.29",
    "typescript": "^4.2.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/chai": "^4.2.17",
    "@types/chai-http": "^4.2.0",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.11",
    "@types/express-session": "^1.18.2",
    "@types/express-validator": "^3.0.0",
    "@types/jsonwebtoken": "^8.5.1",
    "@types/mocha": "^8.2.2",
    "@types/morgan": "^1.9.2",
    "@types/node": "^12.20.1",
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "chai": "^4.3.4",
    "chai-http": "^4.3.0",
    "eslint": "^7.25.0",
    "mocha": "^8.3.2",
    "nodemon": "^2.0.7",
    "prisma": "^2.29.1",
    "ts-node": "^9.1.1"
  }
}
